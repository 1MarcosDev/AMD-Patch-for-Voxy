{
	"schemaVersion": 1,
	"id": "amd-patch-for-voxy",
	"version": "${version}",
	"name": "AMD Patch for Voxy",
	"description": "Fixes rendering issues on AMD GPUs (especially Polaris/RX 500 series) for Voxy's Hierarchical Z-Buffer culling.",
	"authors": [
		"Marquinhos0550"
	],
	"contact": {
		"sources": "https://github.com/Marquinhos0550/AMD-Patch-for-Voxy"
	},
	"license": "MIT",
	"icon": "assets/amd-patch-for-voxy/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.amdfix.client.AMDPatchForVoxyClient"
		]
	},
	"mixins": [
		"amd-patch-for-voxy.mixins.json",
		{
			"config": "amd-patch-for-voxy.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": {
		"voxy": "<0.2.0"
	}
}
